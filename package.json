{
  "name": "dsh-session-cleanup",
  "version": "0.3.0",
  "description": "DeepSeek Harness session cleanup plugin requiring ccch1mneyyy/dsh-TUI (DSH backend): /nix starts fresh; /nix quit deletes and exits.",
  "type": "module",
  "main": "./lib/dsh-entry.js",
  "exports": {
    ".": "./lib/dsh-entry.js"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "npm run build",
    "test:clean": "node -e \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\"",
    "pretest": "npm run test:clean",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "posttest": "npm run test:clean",
    "test:live-driver": "python3 -m unittest discover -s test -p 'test_*.py' -v",
    "check": "npm run lint && npm run test && npm run test:live-driver",
    "package:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "session",
    "cleanup",
    "delete",
    "dsh-tui",
    "session-management",
    "tui",
    "safe-delete",
    "dsh-plugin",
    "dsh"
  ],
  "author": "MasuRii",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyein-cbio/dsh-session-cleanup.git"
  },
  "bugs": {
    "url": "https://github.com/hyein-cbio/dsh-session-cleanup/issues"
  },
  "homepage": "https://github.com/hyein-cbio/dsh-session-cleanup#readme",
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.7.3"
  }
}
